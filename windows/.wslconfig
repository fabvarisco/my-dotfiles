# ============================================================================
#  .wslconfig  (ASCII on purpose: the WSL parser is picky)
#  .wslconfig lives at C:\Users\<YourUser>\.wslconfig  (setup.ps1 copies it)
#  It applies to EVERY WSL2 distro. After a change: `wsl --shutdown` and wait
#  ~8 seconds before opening WSL again.
#  Reference: https://learn.microsoft.com/windows/wsl/wsl-config
# ============================================================================

[wsl2]
# Max RAM for the WSL VM. Default = 50% of Windows RAM.
# Practical rule: half of RAM (16 GB -> 8GB, 32 GB -> 16GB). ADJUST FOR YOUR PC.
memory=8GB

# Logical cores WSL may use. Default = all of them. Leave some free for Windows.
# ADJUST: e.g. 12 threads -> 8.
processors=8

# Swap file on disk. 0 disables it. 4GB avoids OOM during heavy Nix builds.
swap=4GB

# "mirrored" network: WSL sees the same interfaces as Windows.
#  - localhost works in BOTH directions (a WSL dev server opens in the Windows browser)
#  - works better with a VPN
networkingMode=mirrored

# DNS through Windows (fixes DNS problems with a VPN). The default is already true.
dnsTunneling=true

# Honor the Windows proxy, if there is one.
autoProxy=true

# The Windows firewall filters WSL traffic (safe; default true).
firewall=true

# GUI for Linux apps (WSLg). Left on in case you want to run Linux Zed.
guiApplications=true

[experimental]
# Give Windows back cache RAM that Linux is not using.
# "gradual" = slow and without freezes. (Other options: dropCache, disabled)
autoMemoryReclaim=gradual

# A new VHD is born "sparse": when you delete files in Linux, the .vhdx
# shrinks on the Windows disk. This only affects distros installed AFTER this
# config (which is why this file is copied BEFORE `wsl --install`).
sparseVhd=true

# With mirrored networking: allow Windows <-> WSL via the machine IP (not only localhost).
hostAddressLoopback=true
